
@{
    ViewData["Title"] = "fetchAllProducts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-4">
    <h2 class="text-center fw-bold">All Products</h2>
    @if (TempData["message"] != null)
    {
        <div id="successAlert" class="alert alert-success alert-dismissible fade show text-center">
            @TempData["message"]
        </div>
    }
    <div class="row g-4 mt-2">
        @Html.Partial("fetchProducts", ViewData["product"])
    </div>

  
</div>
<script>
    setTimeout(function () {
        var alertBox = document.getElementById("successAlert");
        if (alertBox) {
            alertBox.style.transition = "opacity 0.5s ease";
            alertBox.style.opacity = "0";
            setTimeout(function () {
                alertBox.remove();
            }, 500);
        }
    }, 1000); // 3 seconds
</script>